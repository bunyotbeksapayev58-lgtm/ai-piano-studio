# AI Piano Video Generator Configuration
PROJECT_NAME="AI Piano Video Generator"
VERSION="1.0.0"

# Limits & Parameters
MAX_VIDEO_DURATION_SECONDS=600
MAX_UPLOAD_SIZE_MB=500
RENDER_WIDTH=1280
RENDER_HEIGHT=720
RENDER_FPS=30

# Database
DATABASE_URL=sqlite:///./piano_generator.db

# SoundFont Custom Path (optional, defaults to soundfonts/SalC5Light2.sf2)
# DEFAULT_SOUNDFONT=soundfonts/SalC5Light2.sf2
